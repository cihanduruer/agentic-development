{
  "version": 1,
  "mode": "shadow",
  "enabled": false,
  "killSwitchEnvironmentVariable": "JEV_DISABLED",
  "dataPolicy": {
    "allowed": [
      "capability labels",
      "work item identifier",
      "risk classification",
      "evidence presence",
      "latency and outcome metadata"
    ],
    "denied": [
      "source code",
      "credentials and tokens",
      "personal data",
      "full prompts",
      "internal document bodies"
    ]
  },
  "humanApprovalRequired": [
    "production deployment",
    "permanent deletion",
    "external publication",
    "spending",
    "permission changes",
    "secret access"
  ],
  "decisions": {
    "researchGate": ["accept", "verify_more", "reject"],
    "completionGate": ["complete", "verify_more", "incomplete"],
    "actionGuard": ["allow", "confirm", "human_review", "deny"]
  }
}
