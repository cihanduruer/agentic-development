@page "/"
@using AgenticHotelBooking.Domain
@using System.Globalization
@inject HttpClient Http

<PageTitle>Hotel Booking</PageTitle>

<div class="home-page">
<section class="hero">
    <p class="eyebrow">Your stay starts here</p>
    <h1>Find a room. Book with confidence.</h1>
    <p>Browse hotels, check availability for your dates, and book a room with clear booking rules.</p>
</section>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (hotels is null)
{
    @if (error is null)
    {
        <p role="status">Loading hotels...</p>
    }
}
else if (hotels.Count == 0)
{
    <p class="empty-state" role="status">No hotels are currently available.</p>
}
else
{
    <div class="hotel-grid">
        @foreach (var hotel in hotels)
        {
            <article class="hotel-card">
                <span class="city">@hotel.City</span>
                <h2>@hotel.Name</h2>
                <p>@hotel.Description</p>
                <button class="btn btn-primary" @onclick="() => SelectHotel(hotel)">View rooms</button>
            </article>
        }
    </div>
}

@if (selectedHotel is not null)
{
    <section class="booking-panel" aria-labelledby="booking-title">
        <h2 id="booking-title">Book @selectedHotel.Name</h2>
        <div class="booking-fields">
            <label>Check-in <input type="date" @bind="checkIn" /></label>
            <label>Check-out <input type="date" @bind="checkOut" /></label>
            <label>Guests <input type="number" min="1" max="8" @bind="guests" /></label>
            <button class="btn btn-outline-primary" @onclick="SearchRooms">Check availability</button>
        </div>

        @if (rooms is not null)
        {
            @if (rooms.Count == 0)
            {
                <p class="empty-state" role="status">No rooms are available for these dates and guest count.</p>
            }
            else
            {
                var matchingRooms = GetMatchingRooms();
                @if (AmenityOptions.Count > 0)
                {
                    <fieldset class="amenity-filters" aria-describedby="amenity-filter-help">
                        <legend>Filter available rooms by amenities</legend>
                        <p id="amenity-filter-help">Choose one or more amenities. Rooms must include every selected amenity.</p>
                        <div class="amenity-options">
                            @foreach (var (amenity, index) in AmenityOptions.Select((name, index) => (name, index)))
                            {
                                var inputId = $"amenity-filter-{index}";
                                <label for="@inputId">
                                    <input id="@inputId"
                                           type="checkbox"
                                           checked="@selectedAmenities.Contains(amenity)"
                                           @onchange="args => ToggleAmenity(amenity, args)" />
                                    @amenity
                                </label>
                            }
                        </div>
                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="ClearAmenityFilters"
                                disabled="@(selectedAmenities.Count == 0)">Clear all filters</button>
                    </fieldset>
                }

                @if (matchingRooms.Count == 0)
                {
                    <p class="empty-state" role="status">Available rooms were found, but none match all selected amenities. Clear filters or choose different amenities.</p>
                }
                else
                {
                    <div class="room-list">
                        @foreach (var room in matchingRooms)
                        {
                            <button type="button"
                                    class="room-option @(selectedRoom?.Id == room.Id ? "selected" : null)"
                                    @onclick="() => SelectRoom(room)"
                                    aria-pressed="@(selectedRoom?.Id == room.Id ? "true" : "false")">
                                <strong>@room.Name</strong>
                                <span>Up to @room.Capacity guests</span>
                                <span>@FormatEuro(room.NightlyRate) per night</span>
                                @if (selectedRoom?.Id == room.Id)
                                {
                                    <span class="room-selection">Selected</span>
                                }
                            </button>
                        }
                    </div>
                }
            }
        }

        @if (selectedRoom is not null)
        {
            @if (IsStayValid)
            {
                <dl class="stay-total">
                    <dt>Nightly rate</dt>
                    <dd>@FormatEuro(selectedRoom.NightlyRate)</dd>
                    <dt>Number of nights</dt>
                    <dd>@NumberOfNights</dd>
                    <dt>Total stay price</dt>
                    <dd><strong>@FormatEuro(TotalStayPrice)</strong></dd>
                </dl>
            }
            <div class="confirm-row">
                <label>Guest name <input @bind="guestName" /></label>
                <div class="vehicle-preference">
                    <label for="vehicle-preference">Vehicle preference</label>
                    <select id="vehicle-preference"
                            @bind="vehiclePreference"
                            aria-describedby="vehicle-preference-help"
                            disabled="@(reservation is not null)">
                        <option value="">No preference</option>
                        @foreach (var option in VehiclePreferences)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <p id="vehicle-preference-help">
                        Optional. A vehicle preference is not a guaranteed rental.
                        Choose No preference to clear it before confirming.
                    </p>
                </div>
                <button class="btn btn-success"
                        @onclick="BookRoom"
                        disabled="@(reservation is not null)">Confirm booking</button>
            </div>
        }
    </section>
}

@if (reservation is not null)
{
    <section class="confirmation" role="status">
        <span>Booking confirmed</span>
        <h2>@reservation.Reference</h2>
        <p>@reservation.GuestName · @reservation.CheckIn to @reservation.CheckOut</p>
        <p>Total stay price: <strong>@FormatEuro(reservation.TotalStayPrice)</strong></p>
        <p>Vehicle preference: <strong>@(reservation.VehiclePreference?.ToString() ?? "None")</strong></p>
        <p>A vehicle preference is not a guaranteed rental and cannot be added or changed after confirmation.</p>
    </section>
}
</div>

@code {
    private IReadOnlyList<Hotel>? hotels;
    private Hotel? selectedHotel;
    private IReadOnlyList<Room>? rooms;
    private Room? selectedRoom;
    private Reservation? reservation;
    private string? error;
    private string guestName = string.Empty;
    private VehiclePreference? vehiclePreference;
    private readonly HashSet<string> selectedAmenities = new(StringComparer.OrdinalIgnoreCase);
    private static readonly VehiclePreference[] VehiclePreferences = Enum.GetValues<VehiclePreference>();
    private int guests = 2;
    private DateOnly checkIn = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private DateOnly checkOut = DateOnly.FromDateTime(DateTime.Today.AddDays(2));
    private int NumberOfNights => checkOut.DayNumber - checkIn.DayNumber;
    private bool IsStayValid =>
        checkIn >= DateOnly.FromDateTime(DateTime.Today) && NumberOfNights > 0;
    private decimal TotalStayPrice => selectedRoom?.NightlyRate * NumberOfNights ?? 0m;
    private IReadOnlyList<string> AmenityOptions => selectedHotel?.Rooms
        .SelectMany(room => room.Amenities)
        .Where(amenity => !string.IsNullOrWhiteSpace(amenity))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(amenity => amenity, StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    private static string FormatEuro(decimal amount) =>
        amount.ToString("C", CultureInfo.GetCultureInfo("nl-NL"));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hotels = await Http.GetFromJsonAsync<Hotel[]>("api/hotels") ?? [];
        }
        catch (Exception exception)
        {
            error = $"Hotels could not be loaded: {exception.Message}";
        }
    }

    private void SelectHotel(Hotel hotel)
    {
        selectedHotel = hotel;
        rooms = null;
        selectedRoom = null;
        reservation = null;
        vehiclePreference = null;
        selectedAmenities.Clear();
        error = null;
    }

    private void SelectRoom(Room room)
    {
        StartNewReservationIfConfirmed();
        selectedRoom = room;
        error = null;
    }

    private IReadOnlyList<Room> GetMatchingRooms() =>
        RoomAmenityFilter.MatchAll(rooms ?? [], selectedAmenities);

    private void ToggleAmenity(string amenity, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selectedAmenities.Add(amenity);
        }
        else
        {
            selectedAmenities.Remove(amenity);
        }

        if (selectedRoom is not null &&
            !GetMatchingRooms().Any(room => room.Id == selectedRoom.Id))
        {
            selectedRoom = null;
        }
    }

    private void ClearAmenityFilters()
    {
        selectedAmenities.Clear();
    }

    private async Task SearchRooms()
    {
        if (selectedHotel is null)
        {
            return;
        }

        try
        {
            StartNewReservationIfConfirmed();
            error = null;
            selectedRoom = null;
            rooms = await Http.GetFromJsonAsync<Room[]>(
                $"api/hotels/{selectedHotel.Id}/availability?checkIn={checkIn:yyyy-MM-dd}&checkOut={checkOut:yyyy-MM-dd}&guests={guests}") ?? [];
        }
        catch (Exception exception)
        {
            error = $"Availability could not be checked: {exception.Message}";
        }
    }

    private async Task BookRoom()
    {
        if (selectedHotel is null || selectedRoom is null)
        {
            return;
        }

        try
        {
            error = null;
            var response = await Http.PostAsJsonAsync("api/reservations", new BookingRequest(
                selectedHotel.Id, selectedRoom.Id, checkIn, checkOut, guests, guestName, vehiclePreference));
            if (!response.IsSuccessStatusCode)
            {
                error = await response.Content.ReadAsStringAsync();
                return;
            }

            reservation = await response.Content.ReadFromJsonAsync<Reservation>();
        }
        catch (Exception exception)
        {
            error = $"The booking could not be completed: {exception.Message}";
        }
    }

    private void StartNewReservationIfConfirmed()
    {
        if (reservation is null)
        {
            return;
        }

        reservation = null;
        vehiclePreference = null;
        guestName = string.Empty;
    }
}
