@page "/admin/operations"
@implements IAsyncDisposable
@using System.Text.Json
@using System.Globalization
@inject HttpClient Http
@inject ILogger<Operations> Logger

<PageTitle>Agent Operations</PageTitle>
<AdminNav />

<section class="delivery-page" aria-labelledby="delivery-title">
    <header class="delivery-heading">
        <div>
            <p class="eyebrow">Agent operations</p>
            <h1 id="delivery-title">Your request, step by step</h1>
            <p>Follow one clear path from your idea to the demo site.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="RefreshAsync" disabled="@(busy || approving)">Refresh</button>
    </header>

    @if (error is not null)
    {
        <p class="delivery-notice error" role="alert">@error</p>
    }
    @if (snapshot?.IsStale == true)
    {
        <p class="delivery-notice" role="status">Updates are delayed. Showing the last known progress; approval is paused.</p>
    }
    @if (approval?.Status == "Unavailable")
    {
        <p class="delivery-notice" role="status">@approval.Message</p>
    }
    @if (snapshot is null && busy)
    {
        <p role="status">Finding your current request...</p>
    }
    else if (current is null)
    {
        <p class="delivery-empty">No linked request is available yet. It will appear after intake creates its work link.</p>
    }
    else
    {
        <article class="request-card">
            <div class="request-description">
                <div class="request-pill">
                    <span class="request-number">#@current.WorkItemId</span>
                    <div class="request-copy">
                        <p class="eyebrow">Current request</p>
                        <h2>@(current.BoardsWorkItem?.Title ?? current.GitHubIssueTitle)</h2>
                    </div>
                </div>
                <div class="request-links">
                    <a href="@RequestUrl" target="_blank" rel="noopener noreferrer">View request #@current.WorkItemId</a>
                    <a href="@current.GitHubIssueUrl" target="_blank" rel="noopener noreferrer">View work #@current.GitHubIssueNumber</a>
                </div>
            </div>
            @if (snapshot!.Deliveries.Count > 1)
            {
                <div class="request-picker">
                    <label for="delivery-request">History</label>
                    <select id="delivery-request" value="@selectedId" @onchange="SelectAsync" disabled="@(busy || approving)">
                        <option value="@selectedId" disabled>Choose another request</option>
                        @foreach (var delivery in snapshot.Deliveries.Where(delivery => delivery.WorkItemId != current.WorkItemId))
                        {
                            <option value="@delivery.WorkItemId">@delivery.GitHubIssueTitle</option>
                        }
                    </select>
                </div>
            }
        </article>

        <ol class="delivery-track" aria-label="Request progress">
            @foreach (var step in steps)
            {
                <li class="delivery-step @StepClass(step)" aria-current="@(step == CurrentStep ? "step" : null)">
                    <span class="step-circle" aria-hidden="true">@(step.Status == "Passed" ? "\u2713" : step.Status == "Failed" ? "!" : (steps.IndexOf(step) + 1).ToString(CultureInfo.InvariantCulture))</span>
                    <strong>@step.Name</strong>
                    <span class="step-status">@StatusLabel(step.Status)</span>
                    @if (step.Url is not null)
                    {
                        <a href="@step.Url" target="_blank" rel="noopener noreferrer" aria-label="@($"View {step.Name.ToLowerInvariant()} evidence")">View step</a>
                    }
                </li>
            }
        </ol>

        <section class="delivery-action" aria-label="Next step">
            <h2>@NextHeading</h2>
            <p role="status">@NextMessage</p>
            @if (CurrentStep?.Name == "Your approval")
            {
                <button class="btn btn-primary" @onclick="ApproveAsync" disabled="@(!CanApprove)">
                    @(approving ? "Approving..." : "Approve and publish to demo")
                </button>
                <p class="approval-scope">This publishes to the demo site only. Production approval is separate.</p>
            }
        </section>

        <details class="delivery-details">
            <summary>Details</summary>
            <p>Last successful update: @snapshot!.RefreshedAtUtc.ToLocalTime().ToString("g"). Source updates may take up to five minutes.</p>
            <p>Request connection: @snapshot.BoardsConnection</p>
            @if (snapshot.UnreachableMessage is not null)
            {
                <p>@snapshot.UnreachableMessage</p>
            }
            @if (approval is not null)
            {
                <p>Approval: @approval.Message</p>
                <p>Revision: <code>@approval.HeadSha</code></p>
                @if (approval.ApprovalUrl is not null)
                {
                    <a href="@approval.ApprovalUrl" target="_blank" rel="noopener noreferrer">View approval record</a>
                }
            }
            <p>Checking includes build validation, code review, browser checks and independent QA. Approval readiness is independently verified against trusted main-branch artifacts; those runs may not appear in the recent PR-associated list below. Trusted validation verifies the same revision using the main-branch policy; it is not a second development step. Skipped or incomplete evidence does not count as complete. Optional production steps below do not block demo readiness.</p>
            <ul>
                @foreach (var stage in current.Stages)
                {
                    <li>
                        <strong>@stage.Name</strong>: @stage.Status
                        @if (stage.Url is not null)
                        {
                            <a href="@stage.Url" target="_blank" rel="noopener noreferrer">View run</a>
                        }
                        @foreach (var evidence in stage.RelatedEvidence)
                        {
                            <a href="@evidence.Url" target="_blank" rel="noopener noreferrer">@evidence.Label</a>
                        }
                        @if (stage.HeadSha is not null)
                        {
                            <small>Revision <code>@stage.HeadSha</code></small>
                        }
                    </li>
                }
            </ul>
        </details>
    }
</section>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private Task? polling;
    private DeliveryStatusSnapshot? snapshot;
    private DeliverySummary? current;
    private DevelopmentApprovalState? approval;
    private List<DeliveryProgressStep> steps = [];
    private int? selectedId;
    private bool busy;
    private bool approving;
    private string? error;
    private string? publishMessage;
    private DeliveryProgressStep? CurrentStep => steps.FirstOrDefault(step => step.Status != "Passed");
    private bool CanApprove => !busy && !approving && snapshot?.IsStale == false &&
        error is null && approval?.CanApprove == true && CurrentStep?.Name == "Your approval" &&
        approval.MetadataDigest is { Length: 64 } &&
        approval.HeadSha == current?.Stages.FirstOrDefault(stage => stage.Name == "Pull request")?.HeadSha;
    private string RequestUrl => current?.BoardsWorkItem?.Url ??
        $"https://dev.azure.com/ai-enabled-ado-org/sample-project/_workitems/edit/{current?.WorkItemId}";
    private string NextHeading => CurrentStep is null ? "Your demo is ready" : CurrentStep.Status == "Failed" ? "This step needs attention" : CurrentStep.Name;
    private string NextMessage => publishMessage ?? (CurrentStep?.Status switch
    {
        "Failed" => "A check needs attention before the next step can start. Open its link or Details to see what happened.",
        "Stale" => "Waiting for a fresh update. Nothing will be approved from an outdated view.",
        "Skipped" => "Some required checks were skipped. Full evidence is needed before approval.",
        _ => CurrentStep?.Name switch
        {
            "Received" => "Your request is being picked up.",
            "Being built" => "The development agent is preparing your change.",
            "Checking" => "Your change is being checked. No action is needed from you yet.",
            "Your approval" => approval?.Message ?? "Waiting for the approval checks to finish.",
            "Publishing" => "Your approved change is being published to the demo site.",
            "Ready" => "Publishing finished. Waiting for the final delivery confirmation.",
            _ => "All required steps are complete. Your change is ready on the demo site."
        }
    });

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        polling = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
            {
                await InvokeAsync(RefreshAsync);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task SelectAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var id) && id > 0)
        {
            selectedId = id;
            publishMessage = null;
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (busy || approving || lifetime.IsCancellationRequested) return;
        busy = true;
        error = null;
        approval = null;
        try
        {
            snapshot = await Http.GetFromJsonAsync<DeliveryStatusSnapshot>(
                "api/delivery/status" + (selectedId is int id ? $"?workItemId={id}" : ""), lifetime.Token)
                ?? throw new JsonException("Empty delivery response.");
            if (selectedId is null && snapshot.Deliveries.FirstOrDefault() is { WorkItemId: int firstId })
            {
                selectedId = firstId;
                snapshot = await Http.GetFromJsonAsync<DeliveryStatusSnapshot>($"api/delivery/status?workItemId={firstId}", lifetime.Token)
                    ?? throw new JsonException("Empty selected delivery response.");
            }
            current = snapshot.SelectedDelivery ?? snapshot.Deliveries.FirstOrDefault(item => item.WorkItemId == selectedId);
            publishMessage = null;
            if (current is { PullRequestNumber: int number, WorkItemId: int workItemId } && !snapshot.IsStale)
            {
                approval = await Http.GetFromJsonAsync<DevelopmentApprovalState>(
                    $"api/delivery/approvals/{number}?workItemId={workItemId}", lifetime.Token)
                    ?? throw new JsonException("Empty approval response.");
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "Delivery progress could not be refreshed.");
            error = "Progress could not be refreshed. Approval is paused; please retry.";
            if (snapshot is not null) snapshot = snapshot with { IsStale = true };
        }
        finally
        {
            steps = current is null ? [] : DeliveryProgress.Build(current, approval, snapshot?.IsStale != false).ToList();
            busy = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (!CanApprove || current is not { WorkItemId: int id, PullRequestNumber: int number } || approval is null) return;
        approving = true;
        error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/delivery/approvals",
                new ApproveDevelopmentRequest(id, number, approval.HeadSha, approval.MetadataDigest ?? ""), lifetime.Token);
            if (!response.IsSuccessStatusCode)
            {
                using var problem = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync(lifetime.Token), cancellationToken: lifetime.Token);
                error = problem.RootElement.TryGetProperty("title", out var title)
                    ? title.GetString() : "Approval was not accepted. Refresh and try again.";
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<DevelopmentApprovalResponse>(lifetime.Token)
                ?? throw new JsonException("Empty approval result.");
            publishMessage = result.Message;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "Development approval could not be confirmed.");
            error = "Approval could not be confirmed. Refresh to check its status before trying again.";
        }
        finally { approving = false; }
        if (error is null) await RefreshAsync();
    }

    private static string StepClass(DeliveryProgressStep step) => step.Status.ToLowerInvariant().Replace(' ', '-');
    private static string StatusLabel(string status) => status switch
    {
        "Passed" => "Complete", "Running" => "In progress", "Failed" => "Needs attention",
        "Skipped" => "Checks incomplete", "Stale" => "Update delayed", "Waiting" => "Waiting", _ => "Up next"
    };

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (polling is not null) await polling;
        lifetime.Dispose();
    }
}
