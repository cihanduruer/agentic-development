@page "/admin"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json

<PageTitle>Delivery overview</PageTitle>

<section class="delivery-overview" aria-labelledby="delivery-overview-title">
    <AdminNav />
    <header class="overview-heading">
        <p class="eyebrow">Live delivery evidence · refreshed every 20 seconds</p>
        <h1 id="delivery-overview-title">Delivery overview</h1>
        <p>Follow recent Azure Boards requirements through GitHub evidence and the human production approval gate.</p>
    </header>

    <section class="delivery-controls" aria-label="Delivery selection and refresh status">
        <label for="delivery-selector">Select a recent delivery</label>
        <select id="delivery-selector" value="@selectedWorkItemId" @onchange="SelectDeliveryAsync" disabled="@(snapshot?.Deliveries.Count is null or 0)">
            @if (snapshot is not null)
            {
                @foreach (var item in snapshot.Deliveries.Where(delivery => delivery.WorkItemId.HasValue))
                {
                    <option value="@item.WorkItemId">AB#@item.WorkItemId · @item.GitHubIssueTitle</option>
                }
            }
        </select>
        @if (snapshot is not null)
        {
            <p class="refresh-information">
                Refreshed <time datetime="@snapshot.RefreshedAtUtc.ToString("O")">@RelativeTime(snapshot.RefreshedAtUtc)</time>
                (<time datetime="@snapshot.RefreshedAtUtc.ToString("O")">@snapshot.RefreshedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time>).
            </p>
        }
    </section>

    @if (snapshot is null)
    {
        <p class="delivery-message" role="status">@connectionMessage</p>
    }
    else if (snapshot.Deliveries.Count == 0)
    {
        <p class="delivery-message" role="status">
            @(snapshot.IsStale
                ? snapshot.UnreachableMessage ?? "Delivery status is unreachable; no last-good snapshot is available."
                : "No recent unambiguous GitHub issue with a valid AB# work-item reference was returned.")
        </p>
    }
    else
    {
        @if (snapshot.IsStale || !string.IsNullOrWhiteSpace(connectionMessage) ||
             (Selected is not null && snapshot.BoardsConnection is not "Connected" and not "Unverified"))
        {
            <div class="delivery-message" role="status">
                <strong>@(snapshot.IsStale ? "Delivery status is stale or unreachable." : "Some delivery status is unreachable.")</strong>
                <p>@(connectionMessage ?? snapshot.UnreachableMessage ?? $"Azure Boards: {snapshot.BoardsConnection}.")</p>
            </div>
        }

        <section class="delivery-summary" aria-labelledby="recent-deliveries-title">
            <h2 id="recent-deliveries-title">Recent deliveries</h2>
            <ol class="recent-deliveries">
                @foreach (var item in snapshot.Deliveries.Where(delivery => delivery.WorkItemId.HasValue))
                {
                    <li>
                        <button type="button" class="delivery-choice @(item.WorkItemId == Selected?.WorkItemId ? "selected" : "")"
                                aria-pressed="@(item.WorkItemId == Selected?.WorkItemId)"
                                @onclick="() => SelectWorkItemAsync(item.WorkItemId!.Value)">
                            <span>AB#@item.WorkItemId · @item.GitHubIssueTitle</span>
                            <DeliveryBadge Status="@item.OverallStatus" />
                        </button>
                    </li>
                }
            </ol>
        </section>

        @if (Selected is not null)
        {
            <section class="delivery-detail" aria-labelledby="selected-delivery-title">
                <header class="selected-delivery-heading">
                    <div>
                        <p class="eyebrow">Selected delivery · AB#@Selected.WorkItemId</p>
                        <h2 id="selected-delivery-title">@Selected.GitHubIssueTitle</h2>
                        <p>
                            GitHub issue updated <time datetime="@Selected.UpdatedAtUtc.ToString("O")">@RelativeTime(Selected.UpdatedAtUtc)</time>
                            (@Selected.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")).
                        </p>
                    </div>
                    <DeliveryBadge Status="@Selected.OverallStatus" />
                </header>

                @if (snapshot.BoardsConnection != "Connected")
                {
                    <p class="boards-connection" role="status">
                        <strong>Azure Boards:</strong> @snapshot.BoardsConnection
                        @(Selected.BoardsWorkItem is null ? "" : "Showing the last successful Boards projection.")
                    </p>
                }
                @if (Selected.BoardsWorkItem is not null)
                {
                    <section class="boards-card" aria-labelledby="boards-item-title">
                        <h3 id="boards-item-title">Azure Boards · @Selected.BoardsWorkItem.Type</h3>
                        <p><a href="@Selected.BoardsWorkItem.Url" target="_blank" rel="noopener noreferrer">AB#@Selected.BoardsWorkItem.Id · @Selected.BoardsWorkItem.Title</a></p>
                        <p>State: <strong>@Selected.BoardsWorkItem.State</strong></p>
                        <p>Tags: @(Selected.BoardsWorkItem.Tags.Count == 0 ? "None" : string.Join(", ", Selected.BoardsWorkItem.Tags))</p>
                        @if (Selected.BoardsWorkItem.ChangedAtUtc is DateTimeOffset changed)
                        {
                            <p>Changed <time datetime="@changed.ToString("O")">@RelativeTime(changed)</time> (@changed.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")).</p>
                        }
                        @if (Selected.BoardsWorkItem.Links.Count > 0)
                        {
                            <ul>
                                @foreach (var link in Selected.BoardsWorkItem.Links)
                                {
                                    <li><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Label</a></li>
                                }
                            </ul>
                        }
                    </section>
                }

                <h3 id="delivery-flow-title">End-to-end status flow</h3>
                <p class="sr-only" id="delivery-flow-help">Ordered list of delivery stages and their current evidence status. Arrows in the diagram show the same sequence.</p>
                <ol class="delivery-flow" aria-labelledby="delivery-flow-title" aria-describedby="delivery-flow-help" aria-live="polite" tabindex="0">
                    @foreach (var stage in Selected.Stages)
                    {
                        <li class="delivery-stage @(stage.Status == "Running" ? "running" : "")">
                            <article class="stage-card">
                                <h4>@stage.Name</h4>
                                <DeliveryBadge Status="@stage.Status" />
                                @if (stage.UpdatedAtUtc is DateTimeOffset updated)
                                {
                                    <p class="stage-update">
                                        Last update <time datetime="@updated.ToString("O")">@RelativeTime(updated)</time>
                                        (<time datetime="@updated.ToString("O")">@updated.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</time>)
                                    </p>
                                }
                                else
                                {
                                    <p class="stage-update">Last update: Not available.</p>
                                }
                                @if (stage.DurationMilliseconds is long duration)
                                {
                                    <p>Duration: @FormatDuration(duration)</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(stage.HeadSha))
                                {
                                    <p>Revision: <code>@stage.HeadSha</code></p>
                                }
                                @if (!string.IsNullOrWhiteSpace(stage.Url))
                                {
                                    <p><a href="@stage.Url" target="_blank" rel="noopener noreferrer">Open evidence</a></p>
                                }
                                @if (stage.RelatedEvidence.Count > 0)
                                {
                                    <ul aria-label="@($"{stage.Name} related evidence")">
                                        @foreach (var evidence in stage.RelatedEvidence)
                                        {
                                            <li><a href="@evidence.Url" target="_blank" rel="noopener noreferrer">@evidence.Label</a></li>
                                        }
                                    </ul>
                                }
                            </article>
                        </li>
                    }
                </ol>

                <section class="delivery-evidence-links" aria-label="Selected GitHub delivery links">
                    <h3>Delivery links</h3>
                    <ul>
                        <li><a href="@Selected.GitHubIssueUrl" target="_blank" rel="noopener noreferrer">GitHub issue #@Selected.GitHubIssueNumber</a></li>
                        @if (!string.IsNullOrWhiteSpace(Selected.PullRequestUrl))
                        {
                            <li><a href="@Selected.PullRequestUrl" target="_blank" rel="noopener noreferrer">Pull request #@Selected.PullRequestNumber · @Selected.PullRequestTitle</a></li>
                        }
                    </ul>
                </section>
            </section>
        }
    }
</section>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(20);
    private readonly CancellationTokenSource lifetime = new();
    private DeliveryStatusSnapshot? snapshot;
    private string? selectedWorkItemId;
    private string? connectionMessage;
    private Task? pollTask;

    private DeliverySummary? Selected => snapshot?.SelectedDelivery ??
        snapshot?.Deliveries.FirstOrDefault(item => item.WorkItemId?.ToString() == selectedWorkItemId);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(lifetime.Token);
        pollTask = PollAsync(lifetime.Token);
    }

    private async Task SelectDeliveryAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var workItemId) && workItemId > 0)
        {
            await SelectWorkItemAsync(workItemId);
        }
    }

    private async Task SelectWorkItemAsync(int workItemId)
    {
        selectedWorkItemId = workItemId.ToString(System.Globalization.CultureInfo.InvariantCulture);
        await FetchSelectedAsync(workItemId, lifetime.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var visible = await JS.InvokeAsync<bool>("deliveryStatus.isVisible", cancellationToken);
                if (visible)
                {
                    await InvokeAsync(() => RefreshAsync(cancellationToken));
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSException) { }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            snapshot = await Http.GetFromJsonAsync<DeliveryStatusSnapshot>("api/delivery/status", cancellationToken);
            connectionMessage = null;
            if (snapshot is not null)
            {
                if (selectedWorkItemId is null)
                {
                    selectedWorkItemId = snapshot.Deliveries.FirstOrDefault(item => item.WorkItemId.HasValue)
                        ?.WorkItemId?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                }

                if (int.TryParse(selectedWorkItemId, out var selectedId))
                {
                    await FetchSelectedAsync(selectedId, cancellationToken, render: false);
                }
            }
        }
        catch (Exception exception) when (!cancellationToken.IsCancellationRequested &&
                                          exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            connectionMessage = snapshot is null
                ? "Delivery status is unreachable; no last-good snapshot is available."
                : $"Showing last successful delivery data. The API is unreachable as of {DateTimeOffset.UtcNow:yyyy-MM-dd HH:mm:ss} UTC.";
            if (snapshot is not null)
            {
                snapshot = snapshot with { IsStale = true, UnreachableMessage = connectionMessage };
            }
        }

        StateHasChanged();
    }

    private async Task FetchSelectedAsync(int workItemId, CancellationToken cancellationToken, bool render = true)
    {
        try
        {
            snapshot = await Http.GetFromJsonAsync<DeliveryStatusSnapshot>(
                $"api/delivery/status?workItemId={workItemId.ToString(System.Globalization.CultureInfo.InvariantCulture)}",
                cancellationToken);
            connectionMessage = null;
        }
        catch (Exception exception) when (!cancellationToken.IsCancellationRequested &&
                                          exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            connectionMessage = $"Selected delivery status could not be refreshed. Showing prior data as of {snapshot?.RefreshedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "unknown UTC time"}.";
        }

        if (render)
        {
            StateHasChanged();
        }
    }

    private static string RelativeTime(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1)) return $"{(int)elapsed.TotalMinutes} minutes ago";
        if (elapsed < TimeSpan.FromDays(1)) return $"{(int)elapsed.TotalHours} hours ago";
        return $"{(int)elapsed.TotalDays} days ago";
    }

    private static string FormatDuration(long milliseconds)
    {
        var duration = TimeSpan.FromMilliseconds(milliseconds);
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m {duration.Seconds}s"
            : duration.TotalMinutes >= 1
                ? $"{duration.Minutes}m {duration.Seconds}s"
                : $"{duration.Seconds}s";
    }

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (pollTask is not null)
        {
            try { await pollTask; }
            catch (OperationCanceledException) { }
        }

        lifetime.Dispose();
    }
}
