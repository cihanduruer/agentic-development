    private static string WorkflowUrl(string file) => $"{Repository}/actions/workflows/{file}";
    private sealed record DeliveryStage(string Number, string Type, string Owner, string Title, string Description,
        string Outcome, string ProductOwnerAction, string Tone, string[] Workflows);
    private sealed record Workflow(string Name, string File, string Category, string Trigger, string Description, string Tone);
    private sealed record AzureService(string Name, string Tier, string Description, string Icon, string Tone, string Source);

    private static readonly DeliveryStage[] DeliveryStages =
