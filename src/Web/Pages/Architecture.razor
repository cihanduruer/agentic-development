    private static readonly Workflow[] Workflows =
    [
        new("Agentic intake", "agentic-intake.yml", "Intake", "5-minute schedule / manual", "Links the request to GitHub and assigns the AI developer.", "red"),
        new("Copilot setup steps", "copilot-setup-steps.yml", "Agent environment", "Agent setup / manual", "Prepares the coding environment; setup success does not mean the change is finished.", "gold"),
        new("PR validation", "pr-validation.yml", "Verification", "PR / main push / manual", "Builds and tests the change; trusted validation proves which version was checked.", "blue"),
